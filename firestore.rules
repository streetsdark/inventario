rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isPrivileged() {
      return isAuth() && userRole() in ['admin', 'superuser'];
    }

    function isSuperuser() {
      return isAuth() && userRole() == 'superuser';
    }

    // ── Perfiles de usuario ────────────────────────────────
    match /users/{uid} {
      // Lectura propia o por superuser
      allow read: if isAuth() && request.auth.uid == uid;
      allow read: if isSuperuser();

      // Primer login: el usuario crea su propio doc, solo con role='basic'
      allow create: if isAuth() && request.auth.uid == uid
        && request.resource.data.role == 'basic';

      // El usuario actualiza su propio doc, pero NO puede cambiar el role
      allow update: if isAuth() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;

      // Superuser puede crear y cambiar roles de cualquier usuario
      allow create, update: if isSuperuser();
    }

    // ── Catálogo de productos ──────────────────────────────
    match /products/{id} {
      allow read: if isAuth();
      allow write: if isPrivileged();
    }

    // ── Solicitudes de producto ────────────────────────────
    match /productRequests/{id} {
      allow create: if isAuth();
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid || isPrivileged()
      );
      allow update, delete: if isPrivileged();
    }

    // ── Movimientos ────────────────────────────────────────
    match /moves/{id} {
      allow read, write: if isPrivileged();
    }

    // ── Logs de auditoría ──────────────────────────────────
    // Cualquier usuario autenticado puede crear entradas (el sistema las genera)
    // Solo superuser puede leerlas — nunca se borran ni editan
    match /auditLogs/{id} {
      allow create: if isAuth();
      allow read: if isSuperuser();
    }

    // ── Notificaciones ─────────────────────────────────────
    // Cualquier usuario autenticado puede crear notificaciones
    // Solo admin/superuser pueden leerlas y gestionarlas
    match /notifications/{id} {
      allow create: if isAuth();
      allow read, update, delete: if isPrivileged();
    }
  }
}
