rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isPrivileged() {
      return isAuth() && userRole() in ['admin', 'superuser'];
    }

    function isSuperuser() {
      return isAuth() && userRole() == 'superuser';
    }

    // ── Helpers Account (multi-tenant Fase 1) ─────────────
    function userAccountId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountId
        : null;
    }

    function userAccountRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountRole
        : null;
    }

    function isAccountOwner(accountId) {
      return isAuth() && userAccountId() == accountId && userAccountRole() == 'owner';
    }

    function isAccountAdmin(accountId) {
      return isAuth() && userAccountId() == accountId
        && (userAccountRole() == 'owner' || userAccountRole() == 'admin');
    }

    function isAccountMember(accountId) {
      return isAuth() && userAccountId() == accountId;
    }

    // ── Perfiles de usuario ────────────────────────────────
    match /users/{uid} {
      // Lectura: propia, superuser, o miembros de la misma cuenta
      // (necesario para la lista de miembros de AccountMembersCard)
      allow read: if isAuth() && request.auth.uid == uid;
      allow read: if isSuperuser();
      allow read: if isAuth() && resource.data.accountId != null
        && resource.data.accountId == userAccountId();

      // Primer login: el usuario crea su propio doc con role='basic'
      allow create: if isAuth() && request.auth.uid == uid
        && request.resource.data.role == 'basic';

      // Self-update: no puede cambiar role global
      allow update: if isAuth() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;

      // Cross-update por owner/admin de la misma cuenta (para invitar /
      // expulsar / cambiar rol de miembros). No puede tocar el role global.
      allow update: if isAuth() && request.auth.uid != uid
        && request.resource.data.role == resource.data.role
        && (
          // Caso invitar/expulsar: el actor administra la cuenta destino.
          (request.resource.data.accountId != null
            && isAccountAdmin(request.resource.data.accountId))
          // Caso desvincular (accountId pasa a null): el actor administra la
          // cuenta de origen.
          || (request.resource.data.accountId == null
            && resource.data.accountId != null
            && isAccountAdmin(resource.data.accountId))
        );

      // Superuser puede crear y cambiar roles de cualquier usuario
      allow create, update: if isSuperuser();

      // Delete: solo superuser (modo soporte / wipe de la app).
      // Ningún usuario puede borrar su propio doc desde la app —
      // para eso existe el GDPR delete que pasa por cascade controlado.
      allow delete: if isSuperuser();
    }

    // ── Cuentas (multi-tenant Fase 1) ──────────────────────
    // En esta fase NO se endurecen las colecciones de datos. Solo se
    // habilita la gestión de Accounts y miembros. Endurecimiento global en
    // Fase 4.
    match /accounts/{id} {
      // Lectura: miembros de esa cuenta o superuser.
      allow read: if isAuth() && (
        isAccountMember(id) || isSuperuser()
      );

      // Crear cuenta nueva: el actor se asigna como owner. Validación inline.
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.slug is string
        && request.resource.data.slug.size() >= 3
        && request.resource.data.slug.size() <= 40
        && (request.resource.data.plan in ['free', 'starter', 'pro', 'business'])
        && (request.resource.data.status in ['active', 'suspended', 'trial']);

      // Update: solo owner/admin de esa cuenta. Inmutables: slug, createdAt.
      // ownerId solo lo cambia el owner actual (transferencia).
      allow update: if isAuth() && isAccountAdmin(id)
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.ownerId == resource.data.ownerId
            || isAccountOwner(id));

      // Delete: owner de la cuenta o superuser (modo soporte / wipe).
      allow delete: if isSuperuser()
        || (isAuth() && isAccountOwner(id));
    }

    // ── Helpers de aislamiento por cuenta (Fase 4) ─────────
    // Documento pertenece al usuario actual si tiene su accountId o si es
    // legacy (sin accountId) — los legacy se asumen propios para evitar
    // pérdida de visibilidad mientras se migran con LegacyMigrationCard.
    function docInUserAccount() {
      return resource.data.accountId == userAccountId()
        || resource.data.accountId == null
        || resource.data.accountId == '';
    }

    // Patch válido: accountId nuevo es el del usuario, O se mantiene igual,
    // O se está migrando legacy (de '' / null a un valor real).
    function patchAccountIdValid() {
      return request.resource.data.accountId == userAccountId()
        || request.resource.data.accountId == resource.data.accountId
        || resource.data.accountId == null
        || resource.data.accountId == '';
    }

    // ── Catálogo de productos ──────────────────────────────
    // El superuser global tiene bypass total (rol de soporte). Toda acción
    // suya queda en auditLogs.
    match /products/{id} {
      allow read: if isSuperuser()
        || (isAuth() && docInUserAccount());

      allow create: if isSuperuser()
        || (isPrivileged() && request.resource.data.accountId == userAccountId());

      allow update: if isSuperuser()
        || (isPrivileged() && docInUserAccount() && patchAccountIdValid());

      allow delete: if isSuperuser()
        || (isPrivileged() && docInUserAccount());
    }

    // ── Almacenes ──────────────────────────────────────────
    // Lectura abierta a la cuenta para que el selector global funcione.
    // Validación de nombre se mantiene.
    match /warehouses/{id} {
      allow read: if isSuperuser()
        || (isAuth() && docInUserAccount());

      allow create: if isSuperuser()
        || (isPrivileged()
            && request.resource.data.accountId == userAccountId()
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2
            && request.resource.data.name.size() <= 60);

      allow update: if isSuperuser()
        || (isPrivileged()
            && docInUserAccount()
            && patchAccountIdValid()
            && (!('name' in request.resource.data)
                || (request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 60)));

      // Superuser puede borrar el default (modo soporte).
      // El resto debe usar el flujo asistido que promueve otro primero.
      allow delete: if isSuperuser()
        || (isPrivileged()
            && docInUserAccount()
            && resource.data.isDefault != true);
    }

    // ── Movimientos ────────────────────────────────────────
    match /moves/{id} {
      allow read: if isSuperuser()
        || (isAuth() && docInUserAccount());

      allow create: if isSuperuser()
        || (isPrivileged() && request.resource.data.accountId == userAccountId());

      allow update: if isSuperuser()
        || (isPrivileged() && docInUserAccount() && patchAccountIdValid());

      allow delete: if isSuperuser()
        || (isPrivileged() && docInUserAccount());
    }

    // ── Solicitudes de producto ────────────────────────────
    // Read: propio creador O privileged de la misma cuenta O superuser.
    match /productRequests/{id} {
      allow create: if isSuperuser()
        || (isAuth()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.accountId == userAccountId());

      allow read: if isSuperuser()
        || (isAuth() && resource.data.userId == request.auth.uid && docInUserAccount())
        || (isPrivileged() && docInUserAccount());

      allow update: if isSuperuser()
        || (isPrivileged() && docInUserAccount() && patchAccountIdValid());

      allow delete: if isSuperuser()
        || (isPrivileged() && docInUserAccount());
    }

    // ── Logs de auditoría ──────────────────────────────────
    // Cualquier auth crea (el sistema escribe automáticamente). Solo
    // superuser lee. Nunca se borran/editan. Sin aislamiento por cuenta
    // (los logs son globales para soporte).
    match /auditLogs/{id} {
      allow create: if isAuth();
      allow read: if isSuperuser();
    }

    // ── Import staging (revisión de filas CSV antes de importar) ────
    // Solo privileged de la cuenta o superuser. Validación inline.
    match /importStaging/{id} {
      allow read: if isSuperuser()
        || (isAuth() && docInUserAccount());

      allow create: if isSuperuser()
        || (isPrivileged()
            && request.resource.data.accountId == userAccountId()
            && request.resource.data.status in ['pending', 'imported', 'discarded']);

      allow update: if isSuperuser()
        || (isPrivileged()
            && docInUserAccount()
            && patchAccountIdValid()
            && request.resource.data.status in ['pending', 'imported', 'discarded']);

      allow delete: if isSuperuser()
        || (isPrivileged() && docInUserAccount());
    }

    // ── Notificaciones ─────────────────────────────────────
    match /notifications/{id} {
      allow create: if isSuperuser()
        || (isAuth() && request.resource.data.accountId == userAccountId());

      allow read: if isSuperuser()
        || (isPrivileged() && docInUserAccount());

      allow update, delete: if isSuperuser()
        || (isPrivileged() && docInUserAccount());
    }
  }
}
